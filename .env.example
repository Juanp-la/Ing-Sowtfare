# Copie este archivo como .env (en la raíz del repo) y complete los valores.
# .env está en .gitignore: nunca lo suba al repositorio. Aquí solo van NOMBRES de variables.

# --- Django ---
DJANGO_DEBUG=1
# Obligatoria con DJANGO_DEBUG=0. Genérela con:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (vacío = SQLite local en backend/db.sqlite3) ---
# Formato: URL de PostgreSQL con usuario, clave, host, puerto 5432 y nombre de BD (ver docker-compose.yml)
DATABASE_URL=
POSTGRES_DB=copiloto
POSTGRES_USER=copiloto
POSTGRES_PASSWORD=

# --- Cifrado de campos sensibles (NF02) ---
# Sin valor, en desarrollo se usa una clave efímera (los datos no sobreviven a un reinicio). Genérela con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMPOS_CIFRADO_KEY=

# --- LLM (por defecto falso y determinista; nunca escriba llaves en el código) ---
LLM_PROVIDER=mock
LLM_MODEL=
LLM_CACHE=1
# Si usa un proveedor real, defina aquí la variable de llave que exija su proveedor (por nombre, p. ej. el de LangChain).

# --- Copiloto ---
CUOTA_TOKENS_DEFECTO=20000
COPILOTO_TAREAS_ASINCRONAS=1
MAGNETO_CLIENT=mock
# Auto-login de demo: solo funciona con DJANGO_DEBUG=1 y sin la feature acceso_magneto.
DEV_AUTO_LOGIN=0
